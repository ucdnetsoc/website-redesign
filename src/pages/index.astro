---
import Layout from "../layouts/Layout.astro";
import EventCarousel from "../components/EventCarousel.astro";

import fetchApi from "../lib/strapi";
import type Event from "../interfaces/event.ts";

const events = await fetchApi<Event[]>({
  endpoint: "events?populate=*&sort=date",
  wrappedByKey: "data",
});
---

<Layout title="UCD NetSoc">
  <section id="hero" class="p-8">
    <div class="flex flex-col items-start gap-8 text-white sm:max-w-xs">
      <h1 class="text-left font-display text-5xl leading-tight lg:text-7xl">
        The<br />
        Inter<span class="text-green-500">net</span><br />
        <span class="text-green-500">Soc</span>iety<br />
        @UCD
      </h1>
      <p>
        In 1995, we set out to connect the UCD student populace to the Internet.
        Today, we still have the same goal: to ensure that everyone on campus
        has access to the latest technology.
      </p>
    </div>
  </section>

<section class="bg-gradient-to-b from-black via-gray-900 to-gray-800 py-8">
  <h2 class="mb-8 text-center font-display text-3xl text-white px-8">Events</h2>
  <EventCarousel events={events} />
  
  <div class="mt-8 mb-12 text-center px-8">
    <a 
      href="/event/archive" 
      class="inline-block rounded-lg bg-green-500 px-8 py-4 font-display text-lg font-semibold text-black shadow-lg transition-all hover:bg-green-400 hover:shadow-xl hover:scale-105"
    >
      View All Events →
    </a>
  </div>
</section>


<section class="bg-black py-16 px-8">
  <h2 class="mb-12 text-center font-display text-2xl text-white sm:text-3xl">
    Proudly Sponsored By
  </h2>
  
  <!-- Top Tier Sponsors -->
  <div class="mx-auto max-w-6xl mb-12 grid grid-cols-1 items-center justify-items-center gap-12 sm:grid-cols-3">
    <a
      href="https://kpmg.com/ie/en/home/careers.html"
      rel="noreferrer noopener"
      target="_blank"
      class="group transition-all duration-300 hover:scale-110"
    >
      <img
        src="/sponsor-logos/KPMG.svg"
        alt="KPMG Logo"
        class="h-10 sm:h-14 opacity-80 group-hover:opacity-100 transition-opacity duration-300"
      />
    </a>
    <a
      href="https://careers.sig.com/global-campus/"
      rel="noopener noreferrer"
      target="_blank"
      class="group transition-all duration-300 hover:scale-110"
    >
      <img
        src="/sponsor-logos/SIG.svg"
        alt="SIG Logo"
        class="h-10 sm:h-14 opacity-80 group-hover:opacity-100 transition-opacity duration-300"
      />
    </a>
    <a
      href="https://stripe.com/ie/jobs/university"
      rel="noreferrer noopener"
      target="_blank"
      class="group transition-all duration-300 hover:scale-110"
    >
      <img
        src="/sponsor-logos/Stripe.svg"
        alt="Stripe Logo"
        class="h-10 sm:h-14 opacity-80 group-hover:opacity-100 transition-opacity duration-300"
      />
    </a>
  </div>
  
  <!-- Divider -->
  <div class="mx-auto max-w-4xl mb-12 h-px bg-gradient-to-r from-transparent via-gray-700 to-transparent"></div>
  
  <!-- Secondary Sponsors -->
  <div class="mx-auto max-w-4xl grid grid-cols-1 items-center justify-items-center gap-12 sm:grid-cols-2">
    <a
      href="https://www.arista.com/en/careers/university"
      rel="noopener noreferrer"
      target="_blank"
      class="group transition-all duration-300 hover:scale-110"
    >
      <img
        src="/sponsor-logos/Arista.svg"
        alt="Arista Logo"
        class="h-8 sm:h-12 opacity-80 group-hover:opacity-100 transition-opacity duration-300"
      />
    </a>
    <a
      href="https://www.hubspot.com/careers/jobs?hubs_signup-url=www.hubspot.com%2Fcareers%2Fstudents%2Fintern-coop&hubs_signup-cta=careers-interncoop-bottom&page=1#roleType=intern"
      rel="noopener noreferrer"
      target="_blank"
      class="group transition-all duration-300 hover:scale-110"
    >
      <img
        src="/sponsor-logos/Hubspot.svg"
        alt="Hubspot Logo"
        class="h-10 sm:h-14 brightness-0 invert opacity-80 group-hover:opacity-100 transition-opacity duration-300"
      />
    </a>
  </div>
</section>

</Layout>

<style>
  #hero {
    background-color: black;
    background-image: url("/cgol-header.png");
    /* Background credit: https://spi3lot.itch.io/cgol */
    background-size: cover;
    background-repeat: no-repeat;
    background-position: left;
  }
</style>