---
import type Event from "../interfaces/event.ts";

interface Props {
  event: Event;
}

const event = Astro.props.event.attributes;
---

<a 
  href={`/event/${event.slug}`}
  class="group block max-w-64 shrink-0 bg-black border-2 border-white hover:border-green-500 transition-all duration-150 hover:translate-x-[-4px] hover:translate-y-[-4px] shadow-[6px_6px_0px_0px_rgba(255,255,255,0.2)] hover:shadow-[6px_6px_0px_0px_rgba(34,197,94,1)]"
>
  
  <div class="relative overflow-hidden border-b-2 border-white">
    <img
      src={`${import.meta.env.STRAPI_URL}${event.thumbnail.data.attributes.url}`}
      class="aspect-square w-full object-cover transition-transform duration-300 group-hover:scale-105"
      alt={event.name}
    />
  </div>

  <div class="p-5 space-y-4">
    
    <h3 class="font-bold text-xl text-white group-hover:text-green-500 transition-colors leading-tight">
      {event.name}
    </h3>
    
    
    <div class="space-y-2 text-sm text-gray-300">
      <div class="flex items-baseline gap-2">
        <span class="text-green-500 font-mono w-12 shrink-0">DATE</span>
        <time datetime={event.date} class="font-mono">
          {new Date(event.date).toDateString().slice(4)}, {
            new Date(event.date).toLocaleTimeString([], {
              hour: "2-digit",
              minute: "2-digit",
            })
          }
        </time>
      </div>
      
      <div class="flex items-baseline gap-2">
        <span class="text-green-500 font-mono w-12 shrink-0">LOC</span>
        <span class="font-mono">{event.location}</span>
      </div>
    </div>
    
    
    <p class="text-gray-400 text-sm leading-snug line-clamp-3">
      {event.description}
    </p>

    
    
<div class="pt-2 text-green-500 font-mono text-4xl group-hover:translate-x-2 transition-transform">
  →
</div>

  </div>
</a>